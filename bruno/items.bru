meta {
  name: HomeSwapper and Tenancy returns three items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/swaps
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns three items", function() {
    expect(res.getBody().length).to.equal(3);
  });

  test("each item has an id, number and name", function() {
    res.getBody().forEach(function(i) {
      expect(i).to.have.property("id");
      expect(i).to.have.property("number");
      expect(i).to.have.property("name");
    });
  });

  test("check 1: item 1 name is a string", function() {
    expect(res.getBody()[0].name).to.be.a("string");
  });

  test("check 2: item 2 detail is a string", function() {
    expect(res.getBody()[1].detail).to.be.a("string");
  });

  test("check 3: item 3 status is a string", function() {
    expect(res.getBody()[2].status).to.be.a("string");
  });

  test("check 4: item 1 number is a number", function() {
    expect(res.getBody()[0].number).to.be.a("number");
  });

